<Project>

  <!-- Central Package Management: alle NuGet-versies van deze repository staan hier. Projecten verwijzen alleen nog naar de package-naam. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
  </ItemGroup>

</Project>
